rules_version = '2';
// Resero Site - Firestore security rules.
// Paste into Firebase console > Firestore Database > Rules > Publish (or deploy with the Firebase CLI).
// System administrators: Firestore document system/admins with field "uids" (array of user IDs).
service cloud.firestore {
  match /databases/{db}/documents {

    function signed() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return signed() && request.auth.token.email_verified == true; }
    function isSuper() {
      return signed() && exists(/databases/$(db)/documents/system/admins)
        && request.auth.uid in get(/databases/$(db)/documents/system/admins).data.uids;
    }
    function proj(pid) { return get(/databases/$(db)/documents/projects/$(pid)).data; }
    function roleOf(pid) { return proj(pid).get('members', {}).get(request.auth.uid, ''); }
    function isMember(pid) { return isSuper() || (signed() && roleOf(pid) != ''); }
    function isAdmin(pid) { return isSuper() || (signed() && roleOf(pid) == 'admin'); }
    function canEdit(pid) { return isSuper() || (signed() && roleOf(pid) in ['admin', 'editor']); }
    function isContractor(pid) { return signed() && roleOf(pid) == 'contractor'; }
    // the building owner's team (reports issues, marks maintenance done) and inspectors (raise, comment, accept, reopen)
    function isClient(pid) { return signed() && roleOf(pid) == 'client'; }
    function isInspector(pid) { return signed() && roleOf(pid) == 'inspector'; }
    // Access by organisation (email domain) with a per-person override, set by admins in Users and access:
    // projects/{pid}.access = { orgs: { 'domain.co.nz': { sections: [...], sources: [...] } }, people: { 'name@domain': { sections: [...] } } }
    // An empty list means no limit. Admins are never limited. Register (source) limits apply to editors and viewers only.
    function myDomain() { return myEmail().split('@')[1]; }
    function orgAcc(pid) { return proj(pid).get('access', {}).get('orgs', {}).get(myDomain(), {}); }
    function personSecs(pid) { return proj(pid).get('access', {}).get('people', {}).get(myEmail(), {}).get('sections', []); }
    function secs(pid) { return personSecs(pid).size() > 0 ? personSecs(pid) : orgAcc(pid).get('sections', []); }
    function may(pid, s) { return isSuper() || roleOf(pid) == 'admin' || secs(pid).size() == 0 || secs(pid).hasAny(s); }
    function personSrc(pid) { return proj(pid).get('access', {}).get('people', {}).get(myEmail(), {}).get('sources', []); }
    function scope(pid) { return personSrc(pid).size() > 0 ? personSrc(pid) : orgAcc(pid).get('sources', proj(pid).get('orgScopes', {}).get(myDomain(), [])); }
    // restricted documents: admins, plus the addresses or email domains listed in the project's restrictedTo
    function restrictedOk(pid) { return isAdmin(pid) || (isMember(pid) && proj(pid).get('restrictedTo', []).hasAny([myEmail(), myDomain()])); }
    // a history list may only grow: every earlier entry must still be there, unchanged
    function histKept() { return !changed().hasAny(['history'])
      || (request.resource.data.history.size() >= resource.data.get('history', []).size()
          && request.resource.data.history.hasAll(resource.data.get('history', []))); }
    // who made a change is the person signed in
    function byMe() { return !changed().hasAny(['updatedBy']) || request.resource.data.updatedBy.lower() == myEmail(); }
    function scoped(pid) { return !isSuper() && roleOf(pid) in ['editor', 'viewer', 'client', 'inspector'] && scope(pid).size() > 0; }
    function inScope(pid, src) { return !scoped(pid) || src in scope(pid); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /system/{doc} {
      allow read: if isSuper();
      allow write: if false;            // edit in the Firebase console only
    }

    // Shared library across all Resero projects (typical defects). Any signed-in user can read; editors add to it.
    match /library/{doc} {
      allow read: if signed();
      allow create: if isSuper() || (verified() && request.resource.data.keys().hasOnly(['items', 'updated']) && request.resource.data.get('items', []).size() <= 1);
      allow update: if isSuper() || (verified() && changed().hasOnly(['items', 'updated'])
        && request.resource.data.items.size() >= resource.data.get('items', []).size()
        && request.resource.data.items.size() <= resource.data.get('items', []).size() + 1
        && request.resource.data.items.hasAll(resource.data.get('items', [])));
      allow delete: if isSuper();
    }

    match /invites/{inviteId} {
      allow read: if isAdmin(resource.data.pid) || (verified() && resource.data.email == myEmail());
      allow create, update: if isAdmin(request.resource.data.pid)
        && inviteId == request.resource.data.pid + '_' + request.resource.data.email
        && request.resource.data.role in ['admin', 'editor', 'contractor', 'viewer', 'client', 'inspector'];
      allow delete: if isAdmin(resource.data.pid) || (verified() && resource.data.email == myEmail())
        || (signed() && resource.data.email == myEmail() && request.auth.uid in get(/databases/$(db)/documents/projects/$(resource.data.pid)).data.get('memberUids', []));
    }

    match /projects/{pid} {
      allow read: if isSuper() || (signed() && request.auth.uid in resource.data.memberUids);
      allow create: if isSuper();
      allow delete: if isSuper();
      allow update: if isAdmin(pid)
        // contractors and editors can add names to the subcontractor list
        || ((canEdit(pid) || isContractor(pid)) && changed().hasOnly(['subcontractors']))
        // editors and contractors take the next defect number
        || ((canEdit(pid) || isContractor(pid) || isClient(pid) || isInspector(pid)) && changed().hasOnly(['seq']) && request.resource.data.seq == resource.data.get('seq', 0) + 1)
        // a member records when they last opened the project (their own memberInfo entry only)
        || (isMember(pid) && changed().hasOnly(['memberInfo'])
            && request.resource.data.memberInfo.diff(resource.data.get('memberInfo', {})).affectedKeys().hasOnly([request.auth.uid]))
        // a user accepts an invitation with the secret key from the link in their invitation email (opening it proves the mailbox is theirs)
        || (signed()
            && exists(/databases/$(db)/documents/invites/$(pid + '_' + myEmail()))
            && get(/databases/$(db)/documents/invites/$(pid + '_' + myEmail())).data.get('key', '') is string
            && get(/databases/$(db)/documents/invites/$(pid + '_' + myEmail())).data.get('key', '').size() >= 16
            && request.resource.data.memberInfo[request.auth.uid].get('inviteKey', '') == get(/databases/$(db)/documents/invites/$(pid + '_' + myEmail())).data.key
            && changed().hasOnly(['members', 'memberUids', 'memberInfo'])
            && request.resource.data.members.diff(resource.data.get('members', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid] == get(/databases/$(db)/documents/invites/$(pid + '_' + myEmail())).data.role
            && request.resource.data.memberUids.toSet() == resource.data.get('memberUids', []).toSet().union([request.auth.uid].toSet())
            && request.resource.data.memberInfo.diff(resource.data.get('memberInfo', {})).affectedKeys().hasOnly([request.auth.uid]))
        // a user accepts an invitation sent to their verified email address
        || (verified()
            && exists(/databases/$(db)/documents/invites/$(pid + '_' + myEmail()))
            && changed().hasOnly(['members', 'memberUids', 'memberInfo'])
            && request.resource.data.members.diff(resource.data.get('members', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid] == get(/databases/$(db)/documents/invites/$(pid + '_' + myEmail())).data.role
            && request.resource.data.memberUids.toSet() == resource.data.get('memberUids', []).toSet().union([request.auth.uid].toSet())
            && request.resource.data.memberInfo.diff(resource.data.get('memberInfo', {})).affectedKeys().hasOnly([request.auth.uid]));

      match /plans/{planId} {
        allow read: if isMember(pid);
        allow write: if isAdmin(pid);
      }

      match /defects/{id} {
        allow read: if isMember(pid) && may(pid, ['defects']) && (!scoped(pid) || resource.data.source in scope(pid));
        // contractors can raise items in their own name, and add items to their own registers
        allow create: if may(pid, ['defects']) && ((canEdit(pid) && (!scoped(pid) || request.resource.data.source in scope(pid)))
          || (isContractor(pid) && request.resource.data.get('createdBy', '').lower() == myEmail())
          || (isContractor(pid) && request.resource.data.get('source', '') in proj(pid).get('selfCloseSources', []))
          // the client's team and inspectors raise items in their own name, in the registers they can see
          || ((isClient(pid) || isInspector(pid)) && request.resource.data.get('createdBy', '').lower() == myEmail() && inScope(pid, request.resource.data.get('source', ''))));
        allow delete: if isAdmin(pid);
        allow update: if may(pid, ['defects']) && histKept() && byMe() && ((canEdit(pid) && (!scoped(pid) || (resource.data.source in scope(pid) && request.resource.data.source in scope(pid))))
          // a contractor can edit the items they raised themselves (who raised it cannot be changed)
          || (isContractor(pid)
              && resource.data.get('createdBy', '').lower() == myEmail()
              && !changed().hasAny(['createdBy', 'created']))
          // the client's team and inspectors edit their own items, in the registers they can see
          || ((isClient(pid) || isInspector(pid))
              && resource.data.get('createdBy', '').lower() == myEmail()
              && !changed().hasAny(['createdBy', 'created'])
              && inScope(pid, resource.data.get('source', '')) && inScope(pid, request.resource.data.get('source', '')))
          // an inspector accepts, reopens and comments on anyone's items in its registers
          || (isInspector(pid) && inScope(pid, resource.data.get('source', ''))
              && changed().hasOnly(['status', 'history', 'photos', 'files', 'updated', 'updatedBy']))
          // the client's team comments and adds photos on anyone's items it can see
          || (isClient(pid) && inScope(pid, resource.data.get('source', ''))
              && changed().hasOnly(['history', 'photos', 'files', 'updated', 'updatedBy']))
          // items from the contractor's own registers: the contractor can correct the wording, subcontractor and register details
          || (isContractor(pid)
              && resource.data.get('source', '') in proj(pid).get('selfCloseSources', [])
              && request.resource.data.get('source', '') == resource.data.get('source', '')
              && changed().hasOnly(['desc', 'title', 'ext', 'subcontractor', 'status', 'photos', 'files', 'history', 'updated', 'updatedBy']))
          // on anyone else's items a contractor responds, adds photos and moves the status only
          || (isContractor(pid)
              && changed().hasOnly(['status', 'subcontractor', 'photos', 'files', 'history', 'updated', 'updatedBy'])
              && (request.resource.data.status in ['Open', 'In progress', 'Ready for review', 'Disputed']
                  // items from the contractor's own registers can be closed by the contractor
                  || (request.resource.data.status == 'Closed'
                      && resource.data.get('source', '') in get(/databases/$(db)/documents/projects/$(pid)).data.get('selfCloseSources', [])))
              && resource.data.status != 'Closed'));
      }

      // Facility management: assets and warranties, documents, maintenance tasks, specified systems
      match /assets/{id} {
        allow read: if isMember(pid) && may(pid, ['assets', 'maint', 'comp', 'dash', 'docs']);
        allow write: if canEdit(pid) && may(pid, ['assets', 'maint', 'comp', 'dash', 'docs']);
      }
      match /systems/{id} {
        allow read: if isMember(pid) && may(pid, ['assets', 'maint', 'comp', 'dash', 'docs']);
        allow write: if canEdit(pid) && may(pid, ['assets', 'maint', 'comp', 'dash', 'docs']);
        // the client's team records each year's Form 12A certificates
        allow update: if isClient(pid) && may(pid, ['comp', 'dash']) && changed().hasOnly(['cert12A', 'updated', 'updatedBy']);
      }
      match /docs/{id} {
        allow read: if isMember(pid) && may(pid, ['docs', 'assets', 'maint', 'comp', 'dash', 'guide']);
        allow create: if (canEdit(pid) || isContractor(pid) || isClient(pid)) && may(pid, ['docs', 'assets', 'maint', 'comp', 'dash', 'guide']);      // contractors upload warranties, O&Ms, PS3s; the client's team uploads service reports
        // a contractor may work on a warranty it submitted: the check result, boxes on the document, and resubmission.
        // It can never mark its own submission Accepted, nor move one that was sent back anywhere except Superseded.
        allow update: if (canEdit(pid) && may(pid, ['docs', 'assets', 'maint', 'comp', 'dash', 'guide']))
          || (isContractor(pid) && resource.data.get('submitted', false) == true
              && changed().hasOnly(['sub', 'marks', 'aiRead', 'aiSummary', 'aiProblems', 'title', 'party'])
              && (request.resource.data.sub.status == resource.data.sub.status
                  || (resource.data.sub.status in ['Checking', 'Failed check', 'Awaiting review']
                      && request.resource.data.sub.status in ['Checking', 'Failed check', 'Awaiting review', 'Superseded'])
                  || (resource.data.sub.status == 'Sent back' && request.resource.data.sub.status == 'Superseded')));
        allow delete: if canEdit(pid) && may(pid, ['docs', 'assets', 'maint', 'comp', 'dash', 'guide']);
      }
      // restricted documents (credentials, bonds, guarantees, insurances): admins and the people the project lists
      match /rdocs/{id} {
        allow read: if restrictedOk(pid) && may(pid, ['docs', 'assets', 'maint', 'comp', 'dash', 'guide']);
        allow write: if isAdmin(pid);
      }
      // the change log: one entry per change, stamped with server time and the signed-in user, never changed or removed
      match /log/{id} {
        allow create: if isMember(pid) && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == myEmail() && request.resource.data.at == request.time;
        allow read: if isAdmin(pid);
        allow update, delete: if false;
      }
      // what was sent to whom and when (transmittals), kept as a record
      match /sent/{id} {
        allow read: if canEdit(pid);
        allow create: if canEdit(pid) && request.resource.data.by == myEmail();
        allow update, delete: if false;
      }
      match /actions/{id} {                     // PC conditions, Council RFI items, close-out actions
        allow read: if isMember(pid) && may(pid, ['comp', 'dash']);
        allow write: if canEdit(pid) && may(pid, ['comp', 'dash']);
      }
      match /guide/{id} {                       // Home User Guide pages
        allow read: if isMember(pid) && may(pid, ['guide']);
        allow write: if canEdit(pid) && may(pid, ['guide']);
      }
      match /tasks/{id} {
        allow read: if isMember(pid) && may(pid, ['maint', 'comp', 'dash', 'assets']);
        allow create, delete: if canEdit(pid) && may(pid, ['maint', 'comp', 'dash', 'assets', 'guide']);
        allow update: if histKept() && ((canEdit(pid) && may(pid, ['maint', 'comp', 'dash', 'assets', 'guide']))
          // a contractor can edit the items they raised themselves (who raised it cannot be changed)
          || (isContractor(pid)
              && resource.data.get('createdBy', '').lower() == myEmail()
              && !changed().hasAny(['createdBy', 'created']))
          // on anyone else's items a contractor responds, adds photos and moves the status only
          || ((isContractor(pid) || isClient(pid)) && may(pid, ['maint', 'comp', 'dash', 'assets', 'guide']) && changed().hasOnly(['lastDone', 'nextDue', 'history', 'updated', 'updatedBy'])));
      }

      // Feedback on the app itself: any member can send it, only admins read it
      match /feedback/{id} {
        allow create: if isMember(pid);
        allow read, delete: if isAdmin(pid);
      }

      match /private/{doc} {
        allow read: if isAdmin(pid) || (doc != 'admin' && (canEdit(pid) || isContractor(pid) || isClient(pid) || isInspector(pid)));
        allow write: if isAdmin(pid);
      }
    }
  }
}
