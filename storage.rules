rules_version = '2';
// Resero Defects - Firebase Storage security rules.
// Paste into Firebase console > Storage > Rules > Publish.
service firebase.storage {
  match /b/{bucket}/o {
    function isSuper() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/system/admins)
        && request.auth.uid in firestore.get(/databases/(default)/documents/system/admins).data.uids;
    }
    function roleOf(pid) {
      return firestore.get(/databases/(default)/documents/projects/$(pid)).data.get('members', {}).get(request.auth.uid, '');
    }
    function canRead(pid) { return request.auth != null && (isSuper() || roleOf(pid) != ''); }
    function canUpload(pid) { return request.auth != null && (isSuper() || roleOf(pid) in ['admin', 'editor', 'contractor']); }
    function canDelete(pid) { return request.auth != null && (isSuper() || roleOf(pid) in ['admin', 'editor']); }

    // Handover and FM documents: any file type, up to 150 MB
    match /projects/{pid}/docs/{rest=**} {
      allow read: if canRead(pid);
      allow create, update: if canUpload(pid) && request.resource.size < 150 * 1024 * 1024;
      allow delete: if canDelete(pid);
    }
    // Plans and photos: images and PDFs, up to 20 MB
    match /projects/{pid}/{folder}/{rest=**} {
      allow read: if canRead(pid);
      allow create, update: if folder in ['plans', 'photos'] && canUpload(pid)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/msword|application/vnd.*|text/.*|message/rfc822|application/octet-stream');
      allow delete: if canDelete(pid);
    }
  }
}
